# ==========================================
# Configurações do Bot do Diário Oficial ALETO
# ==========================================

# 1. Telegram
# Obtenha o token criando um bot com o @BotFather no Telegram
TELEGRAM_BOT_TOKEN=seu_token_do_telegram_aqui

# ID de chat do administrador (descubra enviando mensagem para @userinfobot no Telegram)
TELEGRAM_ADMIN_CHAT_ID=123456789

# 2. Inteligência Artificial (Google Gemini)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_api_aqui
GEMINI_MODEL=gemini-2.5-flash

# 3. Monitoramento de Nomes Padrão
# Nomes completos ou termos separados por vírgula que devem ser monitorados para alertas prioritários
DEFAULT_WATCH_NAMES="Seu Nome Completo,Outro Nome Relevante"

# 4. Agendamento e Intervalos
# Intervalo de checagem em minutos durante horário de expediente
CHECK_INTERVAL_MINUTES=30
# Fuso horário para agendamento (Horário de Brasília/Tocantins)
TIMEZONE=America/Araguaina

# 5. Caminhos de Arquivos e Armazenamento
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/diario_aleto.db
LOG_LEVEL=INFO
